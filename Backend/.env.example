# =============================================================================
# 2D Image Anomaly Detection — Environment Configuration Template
# Copy this file to .env and fill in the values.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/anomaly_detection

# ── JWT / Security ────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
# Admin account is created automatically on first startup (NEVER via signup page).
# Password must: be 8+ chars, contain 1 uppercase, 1 digit, 1 special char.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_Strong@2026!
ADMIN_FULL_NAME=System Administrator

# ── SMTP (Email OTP / Password Reset) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=True
SMTP_SSL=False
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME=2D Image Anomaly Detection Platform

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── System Operations ─────────────────────────────────────────────────────────
# Password required for reset-system and wipe-all-users admin endpoints.
SYSTEM_PASSWORD=CHANGE_ME_SystemOps@2026!

# ── CORS ──────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

