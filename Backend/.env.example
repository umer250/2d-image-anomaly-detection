# Environment Variables Example

# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=sqlite:///./anomaly_detection.db

# JWT Configuration
SECRET_KEY=your-secret-key-here-generate-a-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development

# SMTP Configuration (Required for Email Recovery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=True
SMTP_SSL=False
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME="AI Monitoring Platform"

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated for production)
# CORS_ORIGINS=https://your-frontend-domain.vercel.app,https://your-frontend-domain.netlify.app
