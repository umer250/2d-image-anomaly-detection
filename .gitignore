# ===================================
# Runtime Data
# ===================================
# Uploaded images and generated heatmaps (keep folder structure via .gitkeep)
Backend/uploads/*
Backend/heatmaps/*
Backend/static/uploads/*
Backend/static/heatmaps/*
!Backend/uploads/.gitkeep
!Backend/heatmaps/.gitkeep
!Backend/static/uploads/.gitkeep
!Backend/static/heatmaps/.gitkeep
static/

# ===================================
# ML Models
# ===================================
# Large binary files - use Git LFS or external storage
Backend/ml_models/*.pkl
Backend/ml_models/*.pth
Backend/ml_models/*.h5
Backend/ml_models/*.onnx
# Keep config files
!Backend/ml_models/*.json

